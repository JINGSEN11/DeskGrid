<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <StartupObject>DeskGrid.App.Program</StartupObject>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <AssemblyName>DeskGrid</AssemblyName>
    <RootNamespace>DeskGrid.App</RootNamespace>
    <Product>DeskGrid</Product>
    <Version>0.2.0</Version>
    <Authors>JINGSEN11</Authors>
    <Description>Lightweight open-source Windows desktop organizer and Fluent Dock.</Description>
    <Copyright>Copyright (c) 2026 JINGSEN11</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <NoWarn>$(NoWarn);WPF0001</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="Assets\app.ico" />
    <Resource Include="Assets\app_256.png" />
    <Resource Include="Assets\donate_wechat.png" Condition="Exists('Assets\donate_wechat.png')" />
    <Resource Include="Assets\social_xhs.png" Condition="Exists('Assets\social_xhs.png')" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\DeskGrid.Core\DeskGrid.Core.csproj" />
    <ProjectReference Include="..\DeskGrid.Win32\DeskGrid.Win32.csproj" />
  </ItemGroup>
</Project>
