<Window x:Class="DeskGrid.App.Views.DesktopBoxWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Icon="pack://application:,,,/Assets/app.ico"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="Transparent"
        AllowDrop="True"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="Grayscale"
        PreviewKeyDown="OnPreviewKeyDown"
        MouseEnter="OnBoxMouseEnter"
        MouseLeave="OnBoxMouseLeave"
        DragEnter="OnBoxDragOver"
        DragOver="OnBoxDragOver"
        DragLeave="OnBoxDragLeave"
        Drop="OnBoxDrop">

    <Window.Resources>
        <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="TextOptions.TextRenderingMode" Value="Grayscale"/>
        </Style>
    </Window.Resources>

    <!-- 14px transparent gutter hosts soft outer drop shadow without clipping -->
    <Grid Margin="14">
        <!-- Dedicated sibling shadow + glass tint layer: NEVER wraps foreground text or icons -->
        <Border x:Name="ShadowBackdrop"
                CornerRadius="18"
                IsHitTestVisible="False">
            <Border.Effect>
                <DropShadowEffect BlurRadius="26"
                                  ShadowDepth="6"
                                  Direction="270"
                                  Opacity="0.28"
                                  Color="#000000"/>
            </Border.Effect>
        </Border>

        <!-- Crisp foreground glass frame & content layer: ZERO DropShadowEffect / shader rasterization -->
        <Border x:Name="RootCard"
                CornerRadius="18"
                Background="Transparent"
                BorderThickness="1"
                BorderBrush="{DynamicResource DgGlassBorderBrush}"
                SnapsToDevicePixels="True"
                MouseLeftButtonDown="OnBoxCardMouseLeftButtonDown"
                MouseRightButtonUp="OnBoxCardRightClick">

            <Grid>
                <!-- Subtle Liquid Glass specular highlight sheen -->
                <Border CornerRadius="17"
                        Background="{DynamicResource DgGlassSheenBrush}"
                        IsHitTestVisible="False"/>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="34"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Frameless floating header: no background bar, no divider -->
                    <Border x:Name="TitleBar"
                            Grid.Row="0"
                            Background="Transparent"
                            Padding="14,6,10,0"
                            MouseLeftButtonDown="OnTitleBarMouseDown">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Subfolder Back Button (FolderPortal only when navigated in) -->
                            <Button x:Name="BackButton"
                                    Grid.Column="0"
                                    Content="&#xE72B;"
                                    Style="{StaticResource DgIconButtonStyle}"
                                    ToolTip="返回上级目录"
                                    Visibility="Collapsed"
                                    Margin="0,0,4,0"
                                    Click="OnNavigateBack"/>

                            <!-- Subtle mode glyph -->
                            <TextBlock x:Name="ModeGlyph"
                                       Grid.Column="1"
                                       FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                       FontSize="12"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource DgAccentBrush}"
                                       Opacity="0.9"
                                       Margin="0,0,6,0"/>

                            <!-- Floating crisp title (no DropShadowEffect rasterization) -->
                            <TextBlock x:Name="TitleText"
                                       Grid.Column="2"
                                       VerticalAlignment="Center"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource DgTextPrimaryBrush}"
                                       TextTrimming="CharacterEllipsis"/>

                            <!-- Auto-hidden header action buttons (fade in 150ms on card hover) -->
                            <StackPanel x:Name="HeaderActionsPanel"
                                        Grid.Column="3"
                                        Orientation="Horizontal"
                                        VerticalAlignment="Center"
                                        Opacity="0"
                                        IsHitTestVisible="False">
                                <Button x:Name="LockButton"
                                        Content="&#xE785;"
                                        Style="{StaticResource DgIconButtonStyle}"
                                        ToolTip="锁定/解锁位置与大小"
                                        Click="OnToggleLock"/>
                                <Button x:Name="CollapseButton"
                                        Content="&#xE70E;"
                                        Style="{StaticResource DgIconButtonStyle}"
                                        ToolTip="卷起/展开盒子（卷起后悬停自动展开）"
                                        Click="OnToggleCollapse"/>
                                <Button x:Name="MenuButton"
                                        Content="&#xE712;"
                                        Style="{StaticResource DgIconButtonStyle}"
                                        ToolTip="盒子选项"
                                        Click="OnOpenBoxMenu"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Content Body -->
                    <Grid x:Name="BodyContainer" Grid.Row="1">
                        <ScrollViewer x:Name="ItemsScrollViewer"
                                      Background="Transparent"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled"
                                      Padding="14,6,14,14">
                            <ScrollViewer.Resources>
                                <Style TargetType="ScrollBar" BasedOn="{StaticResource DgThinScrollBar}"/>
                            </ScrollViewer.Resources>
                            <Grid>
                                <WrapPanel x:Name="ItemsWrapPanel" Orientation="Horizontal"/>
                                <Canvas x:Name="ReorderIndicatorCanvas"
                                        IsHitTestVisible="False"
                                        ClipToBounds="False">
                                    <Border x:Name="ReorderDropIndicator"
                                            Width="7"
                                            Height="56"
                                            CornerRadius="3.5"
                                            Background="{DynamicResource DgAccentMutedBrush}"
                                            Visibility="Collapsed"
                                            IsHitTestVisible="False">
                                        <Border Width="2.5"
                                                Margin="0,2,0,2"
                                                HorizontalAlignment="Center"
                                                CornerRadius="1.25"
                                                Background="{DynamicResource DgAccentBrush}"/>
                                    </Border>
                                </Canvas>
                            </Grid>
                        </ScrollViewer>

                        <!-- Empty State Hint -->
                        <StackPanel x:Name="EmptyStatePanel"
                                    VerticalAlignment="Center"
                                    HorizontalAlignment="Center"
                                    IsHitTestVisible="False"
                                    Visibility="Collapsed">
                            <TextBlock Text="&#xE896;"
                                       FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                       FontSize="20"
                                       HorizontalAlignment="Center"
                                       Foreground="{DynamicResource DgTextSecondaryBrush}"
                                       Opacity="0.72"
                                       Margin="0,0,0,6"/>
                            <TextBlock x:Name="EmptyHintText"
                                       Text="拖拽文件、文件夹或应用到此处"
                                       FontSize="12"
                                       FontWeight="Medium"
                                       Foreground="{DynamicResource DgTextSecondaryBrush}"
                                       Opacity="0.86"/>
                        </StackPanel>

                        <!-- Drop Overlay Feedback -->
                        <Border x:Name="DropHighlightBorder"
                                Margin="10"
                                CornerRadius="12"
                                BorderThickness="1.5"
                                BorderBrush="{DynamicResource DgAccentBrush}"
                                Background="{DynamicResource DgAccentMutedBrush}"
                                Visibility="Collapsed"
                                IsHitTestVisible="False"/>
                    </Grid>
                </Grid>

                <!-- Invisible Edge & Corner Resize Hit Areas (zero visible slash handle) -->
                <Thumb x:Name="RightResizeThumb"
                       Width="6"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Stretch"
                       Margin="0,12,0,14"
                       Cursor="SizeWE"
                       Opacity="0"
                       DragDelta="OnRightResizeDragDelta"
                       DragCompleted="OnResizeDragCompleted"/>
                <Thumb x:Name="BottomResizeThumb"
                       Height="6"
                       HorizontalAlignment="Stretch"
                       VerticalAlignment="Bottom"
                       Margin="12,0,14,0"
                       Cursor="SizeNS"
                       Opacity="0"
                       DragDelta="OnBottomResizeDragDelta"
                       DragCompleted="OnResizeDragCompleted"/>
                <Thumb x:Name="CornerResizeThumb"
                       Width="14"
                       Height="14"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Bottom"
                       Cursor="SizeNWSE"
                       Opacity="0"
                       DragDelta="OnCornerResizeDragDelta"
                       DragCompleted="OnResizeDragCompleted"/>
            </Grid>
        </Border>
    </Grid>
</Window>
