<Window x:Class="DeskGrid.App.Views.CreateBoxDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="新建桌面盒子"
        Width="440"
        Height="320"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="ClearType">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="新建桌面分区盒子"
                   FontSize="18"
                   FontWeight="SemiBold"
                   Margin="0,0,0,14"/>

        <StackPanel Grid.Row="1" Margin="0,0,0,12">
            <TextBlock Text="盒子名称" Margin="0,0,0,6" Opacity="0.85"/>
            <TextBox x:Name="TitleTextBox" Text="常用工具" Height="34" VerticalContentAlignment="Center"/>
        </StackPanel>

        <StackPanel Grid.Row="2" Margin="0,0,0,12">
            <TextBlock Text="管理模式" Margin="0,0,0,6" Opacity="0.85"/>
            <StackPanel Orientation="Horizontal">
                <RadioButton x:Name="VirtualModeRadio"
                             Content="虚拟盒子（不移动磁盘原文件）"
                             IsChecked="True"
                             Checked="OnModeChanged"
                             Margin="0,0,18,0"/>
                <RadioButton x:Name="FolderModeRadio"
                             Content="目录映射（实时同步文件夹）"
                             Checked="OnModeChanged"/>
            </StackPanel>
        </StackPanel>

        <StackPanel x:Name="FolderPickerPanel" Grid.Row="3" Visibility="Collapsed" Margin="0,4,0,0">
            <TextBlock Text="绑定本地文件夹" Margin="0,0,0,6" Opacity="0.85"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="FolderPathTextBox" Height="34" VerticalContentAlignment="Center" IsReadOnly="True"/>
                <Button Grid.Column="1" Content="浏览..." Width="76" Height="34" Margin="8,0,0,0" Click="OnBrowseFolder"/>
            </Grid>
        </StackPanel>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="取消" Width="84" Height="32" IsCancel="True" Margin="0,0,8,0"/>
            <Button Content="创建" Width="92" Height="32" IsDefault="True" Click="OnConfirm"/>
        </StackPanel>
    </Grid>
</Window>
