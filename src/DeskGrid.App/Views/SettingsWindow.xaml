<Window x:Class="DeskGrid.App.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DeskGrid 偏好设置"
        Icon="pack://application:,,,/Assets/app.ico"
        Width="660"
        Height="580"
        MinWidth="600"
        MinHeight="500"
        ShowInTaskbar="True"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="ClearType"
        Closing="OnWindowClosing">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock Text="DeskGrid 设置" FontSize="22" FontWeight="SemiBold"/>
            <TextBlock Text="自定义桌面盒子、Dock 栏与系统协同行为" Opacity="0.72" Margin="0,2,0,0"/>
        </StackPanel>

        <TabControl Grid.Row="1">
            <!-- Tab 1: 外观与桌面 -->
            <TabItem Header="外观与桌面">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              CanContentScroll="False"
                              Padding="14">
                    <StackPanel>
                        <TextBlock Text="视觉主题" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,8"/>
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="深浅色模式" VerticalAlignment="Center"/>
                            <ComboBox x:Name="ThemeCombo" Grid.Column="1" Width="220" HorizontalAlignment="Left" SelectionChanged="OnSettingChanged">
                                <ComboBoxItem Content="跟随 Windows 系统" Tag="System"/>
                                <ComboBoxItem Content="浅色模式" Tag="Light"/>
                                <ComboBoxItem Content="深色模式" Tag="Dark"/>
                            </ComboBox>
                        </Grid>

                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Win11 毛玻璃材质" VerticalAlignment="Center"/>
                            <ComboBox x:Name="BackdropCombo" Grid.Column="1" Width="220" HorizontalAlignment="Left" SelectionChanged="OnSettingChanged">
                                <ComboBoxItem Content="Acrylic 亚克力" Tag="Acrylic"/>
                                <ComboBoxItem Content="Mica 云母" Tag="Mica"/>
                            </ComboBox>
                        </Grid>

                        <Grid Margin="0,0,0,18">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="48"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="玻璃默认着色浓度" VerticalAlignment="Center"/>
                            <Slider x:Name="OpacitySlider"
                                    Grid.Column="1"
                                    Minimum="0.18"
                                    Maximum="0.80"
                                    SmallChange="0.01"
                                    LargeChange="0.05"
                                    TickFrequency="0.01"
                                    IsSnapToTickEnabled="False"
                                    IsMoveToPointEnabled="True"
                                    ValueChanged="OnOpacitySliderValueChanged"/>
                            <TextBlock x:Name="OpacityValueText" Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                        </Grid>

                        <Separator Margin="0,4,0,14"/>
                        <TextBlock Text="桌面交互" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,8"/>

                        <CheckBox x:Name="StartupCheck" Content="随 Windows 开机自动启动（用户级，无需管理员权限）" Margin="0,4,0,8" Checked="OnSettingChanged" Unchecked="OnSettingChanged"/>
                        <CheckBox x:Name="DoubleClickDesktopCheck" Content="双击桌面空白处一键隐藏 / 恢复所有桌面盒子" Margin="0,4,0,8" Checked="OnSettingChanged" Unchecked="OnSettingChanged"/>
                        <CheckBox x:Name="GridSnapCheck" Content="拖拽与缩放盒子时启用网格与边缘吸附对齐" Margin="0,4,0,8" Checked="OnSettingChanged" Unchecked="OnSettingChanged"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Tab 2: Dock 栏 -->
            <TabItem Header="Dock 栏">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              CanContentScroll="False"
                              Padding="14">
                    <StackPanel>
                        <TextBlock Text="Dock 体验与动效" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,8"/>
                        <CheckBox x:Name="ShowDockCheck" Content="启用底部悬浮 Dock 栏" Margin="0,4,0,10" Checked="OnSettingChanged" Unchecked="OnSettingChanged"/>

                        <StackPanel x:Name="DockOptionsPanel">
                            <CheckBox x:Name="MagnificationCheck" Content="启用鼠标悬停波浪放大动效" Margin="0,0,0,10" Checked="OnSettingChanged" Unchecked="OnSettingChanged"/>

                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="160"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="48"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="最大放大倍率" VerticalAlignment="Center"/>
                                <Slider x:Name="MagScaleSlider"
                                        Grid.Column="1"
                                        Minimum="1.10"
                                        Maximum="1.70"
                                        SmallChange="0.01"
                                        LargeChange="0.05"
                                        TickFrequency="0.01"
                                        IsSnapToTickEnabled="False"
                                        IsMoveToPointEnabled="True"
                                        ValueChanged="OnSettingChanged"/>
                                <TextBlock x:Name="MagScaleValueText" Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                            </Grid>

                            <Separator Margin="0,4,0,14"/>
                            <TextBlock Text="防打扰与任务栏协同" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,8"/>

                            <CheckBox x:Name="FullscreenHideCheck" Content="检测到全屏游戏或全屏视频时自动静默隐藏 Dock" Margin="0,4,0,8" Checked="OnSettingChanged" Unchecked="OnSettingChanged"/>
                            <CheckBox x:Name="HideTaskbarCheck" Content="自动隐藏 Windows 原生任务栏（安全机制：退出软件后自动恢复）" Margin="0,4,0,6" Checked="OnSettingChanged" Unchecked="OnSettingChanged"/>
                            <TextBlock x:Name="TaskbarUncheckedHintText"
                                       Text="提示：未开启隐藏原生任务栏时，Dock 会自动悬浮在原生任务栏上方，互不遮挡。"
                                       FontSize="12"
                                       Opacity="0.68"
                                       TextWrapping="Wrap"
                                       Margin="24,0,0,4"/>
                            <TextBlock x:Name="TaskbarCheckedHintText"
                                       Text="已开启原生任务栏隐藏，退出 DeskGrid 时将自动恢复。"
                                       FontSize="12"
                                       Opacity="0.78"
                                       TextWrapping="Wrap"
                                       Visibility="Collapsed"
                                       Margin="24,0,0,4"/>

                            <Separator Margin="0,10,0,14"/>
                            <TextBlock Text="Dock 右侧时钟" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,8"/>

                            <CheckBox x:Name="ShowDockClockCheck" Content="在 Dock 栏右侧显示极简时钟（点击可打开快捷电源菜单）" Margin="0,4,0,8" Checked="OnSettingChanged" Unchecked="OnSettingChanged"/>
                            <StackPanel x:Name="ClockOptionsPanel" Margin="24,0,0,4">
                                <CheckBox x:Name="Clock24HourCheck" Content="使用 24 小时制（关闭后切换为 12 小时制）" Margin="0,2,0,8" Checked="OnSettingChanged" Unchecked="OnSettingChanged"/>
                                <CheckBox x:Name="ClockShowSecondsCheck" Content="显示秒数" Margin="0,2,0,8" Checked="OnSettingChanged" Unchecked="OnSettingChanged"/>
                                <CheckBox x:Name="ClockShowDateCheck" Content="显示日期与星期" Margin="0,2,0,4" Checked="OnSettingChanged" Unchecked="OnSettingChanged"/>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Tab 3: 配置与备份 -->
            <TabItem Header="配置与备份">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              CanContentScroll="False"
                              Padding="14">
                    <StackPanel>
                        <TextBlock Text="配置导入导出与恢复" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,6"/>
                        <TextBlock Text="所有桌面盒子布局、虚拟条目与 Dock 固定项均以 JSON 保存在本地，并自动维护 3 份滚动备份。"
                                   TextWrapping="Wrap"
                                   Opacity="0.75"
                                   Margin="0,0,0,16"/>

                        <WrapPanel Margin="0,0,0,16">
                            <Button Content="导出配置 (.deskgrid)" Height="34" Padding="14,0" Margin="0,0,10,8" Click="OnExportConfig"/>
                            <Button Content="导入配置..." Height="34" Padding="14,0" Margin="0,0,10,8" Click="OnImportConfig"/>
                            <Button Content="打开配置目录" Height="34" Padding="14,0" Margin="0,0,10,8" Click="OnOpenConfigFolder"/>
                        </WrapPanel>

                        <Separator Margin="0,6,0,16"/>
                        <TextBlock Text="紧急恢复与重置" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,8"/>
                        <WrapPanel>
                            <Button Content="立即恢复系统任务栏与原生图标" Height="34" Padding="14,0" Margin="0,0,10,8" Click="OnEmergencyRestore"/>
                            <Button Content="重置为默认布局" Height="34" Padding="14,0" Margin="0,0,10,8" Click="OnResetDefaults"/>
                        </WrapPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="完成" Width="88" Height="32" IsDefault="True" Click="OnClose"/>
        </StackPanel>
    </Grid>
</Window>
