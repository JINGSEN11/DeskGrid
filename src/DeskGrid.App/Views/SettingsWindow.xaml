<Window x:Class="DeskGrid.App.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DeskGrid 偏好设置"
        Icon="pack://application:,,,/Assets/app.ico"
        Width="760"
        Height="580"
        MinWidth="680"
        MinHeight="500"
        ShowInTaskbar="True"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="ClearType"
        Closing="OnWindowClosing">
    <Window.Resources>
        <Style x:Key="DgSettingsNavRadioStyle" TargetType="RadioButton">
            <Setter Property="Height" Value="38"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
            <Setter Property="Padding" Value="12,0,12,0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <Grid>
                                <Border x:Name="ActivePill"
                                        Width="3"
                                        Height="16"
                                        CornerRadius="1.5"
                                        HorizontalAlignment="Left"
                                        Margin="-8,0,0,0"
                                        Background="#0A84FF"
                                        Visibility="Collapsed"/>
                                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#14808080"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#22808080"/>
                                <Setter TargetName="ActivePill" Property="Visibility" Value="Visible"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DgSettingsSafeExitButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="12,0,12,0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#E5484D"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#38E5484D"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1CE5484D"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#70E5484D"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#2EE5484D"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock Text="DeskGrid 设置" FontSize="22" FontWeight="SemiBold"/>
            <TextBlock Text="自定义桌面盒子、Dock 栏与系统协同行为" Opacity="0.72" Margin="0,2,0,0"/>
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="176"/>
                <ColumnDefinition Width="1"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left Navigation Rail -->
            <Grid Grid.Column="0" Margin="0,0,12,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0">
                    <RadioButton x:Name="NavAppearanceRadio"
                                 GroupName="SettingsNav"
                                 Style="{StaticResource DgSettingsNavRadioStyle}"
                                 IsChecked="True"
                                 Checked="OnNavSectionChanged">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="&#xE790;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <TextBlock Text="外观与桌面" VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>

                    <RadioButton x:Name="NavDockRadio"
                                 GroupName="SettingsNav"
                                 Style="{StaticResource DgSettingsNavRadioStyle}"
                                 Checked="OnNavSectionChanged">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="&#xE756;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <TextBlock Text="Dock 栏" VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>

                    <RadioButton x:Name="NavBackupRadio"
                                 GroupName="SettingsNav"
                                 Style="{StaticResource DgSettingsNavRadioStyle}"
                                 Checked="OnNavSectionChanged">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="&#xE74E;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <TextBlock Text="配置与备份" VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>

                    <RadioButton x:Name="NavAboutRadio"
                                 GroupName="SettingsNav"
                                 Style="{StaticResource DgSettingsNavRadioStyle}"
                                 Checked="OnNavSectionChanged">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="&#xE946;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <TextBlock Text="关于与支持" VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>
                </StackPanel>

                <!-- Independent Safe Exit Button pinned at the very bottom of the left nav rail -->
                <StackPanel Grid.Row="1" Margin="0,8,0,0">
                    <Separator Margin="0,0,0,10" Opacity="0.5"/>
                    <Button x:Name="SafeExitButton"
                            Style="{StaticResource DgSettingsSafeExitButtonStyle}"
                            ToolTip="恢复原生任务栏与桌面图标并安全退出 DeskGrid"
                            Click="OnSafeExit">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="&#xE7E8;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <TextBlock Text="安全退出" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Subtle vertical divider -->
            <Border Grid.Column="1" Background="#24808080"/>

            <!-- Right Content Sections -->
            <Grid Grid.Column="2" Margin="14,0,0,0">
                <!-- Section 1: 外观与桌面 -->
                <ScrollViewer x:Name="AppearanceSection"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              CanContentScroll="False"
                              Padding="6,4,10,4">
                    <StackPanel>
                        <TextBlock Text="视觉主题" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,8"/>
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="深浅色模式" VerticalAlignment="Center"/>
                            <ComboBox x:Name="ThemeCombo" Grid.Column="1" Width="220" HorizontalAlignment="Left" SelectionChanged="OnSettingChanged">
                                <ComboBoxItem Content="跟随 Windows 系统" Tag="System"/>
                                <ComboBoxItem Content="浅色模式" Tag="Light"/>
                                <ComboBoxItem Content="深色模式" Tag="Dark"/>
                            </ComboBox>
                        </Grid>

                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Win11 毛玻璃材质" VerticalAlignment="Center"/>
                            <ComboBox x:Name="BackdropCombo" Grid.Column="1" Width="220" HorizontalAlignment="Left" SelectionChanged="OnSettingChanged">
                                <ComboBoxItem Content="Acrylic 亚克力" Tag="Acrylic"/>
                                <ComboBoxItem Content="Mica 云母" Tag="Mica"/>
                            </ComboBox>
                        </Grid>

                        <Grid Margin="0,0,0,18">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="48"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="玻璃默认着色浓度" VerticalAlignment="Center"/>
                            <Slider x:Name="OpacitySlider"
                                    Grid.Column="1"
                                    Minimum="0.18"
                                    Maximum="0.80"
                                    SmallChange="0.01"
                                    LargeChange="0.05"
                                    TickFrequency="0.01"
                                    IsSnapToTickEnabled="False"
                                    IsMoveToPointEnabled="True"
                                    ValueChanged="OnOpacitySliderValueChanged"/>
                            <TextBlock x:Name="OpacityValueText" Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                        </Grid>

                        <Separator Margin="0,4,0,14"/>
                        <TextBlock Text="桌面交互" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,8"/>

                        <CheckBox x:Name="StartupCheck" Content="随 Windows 开机自动启动（用户级，无需管理员权限）" Margin="0,4,0,8" Checked="OnSettingChanged" Unchecked="OnSettingChanged"/>
                        <CheckBox x:Name="DoubleClickDesktopCheck" Content="双击桌面空白处一键隐藏 / 恢复所有桌面盒子" Margin="0,4,0,8" Checked="OnSettingChanged" Unchecked="OnSettingChanged"/>
                        <CheckBox x:Name="GridSnapCheck" Content="拖拽与缩放盒子时启用网格与边缘吸附对齐" Margin="0,4,0,8" Checked="OnSettingChanged" Unchecked="OnSettingChanged"/>
                    </StackPanel>
                </ScrollViewer>

                <!-- Section 2: Dock 栏 -->
                <ScrollViewer x:Name="DockSection"
                              Visibility="Collapsed"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              CanContentScroll="False"
                              Padding="6,4,10,4">
                    <StackPanel>
                        <TextBlock Text="Dock 体验与动效" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,8"/>
                        <CheckBox x:Name="ShowDockCheck" Content="启用底部悬浮 Dock 栏" Margin="0,4,0,10" Checked="OnSettingChanged" Unchecked="OnSettingChanged"/>

                        <StackPanel x:Name="DockOptionsPanel">
                            <CheckBox x:Name="MagnificationCheck" Content="启用鼠标悬停波浪放大动效" Margin="0,0,0,10" Checked="OnSettingChanged" Unchecked="OnSettingChanged"/>

                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="160"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="48"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="最大放大倍率" VerticalAlignment="Center"/>
                                <Slider x:Name="MagScaleSlider"
                                        Grid.Column="1"
                                        Minimum="1.10"
                                        Maximum="1.70"
                                        SmallChange="0.01"
                                        LargeChange="0.05"
                                        TickFrequency="0.01"
                                        IsSnapToTickEnabled="False"
                                        IsMoveToPointEnabled="True"
                                        ValueChanged="OnSettingChanged"/>
                                <TextBlock x:Name="MagScaleValueText" Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                            </Grid>

                            <Separator Margin="0,4,0,14"/>
                            <TextBlock Text="防打扰与任务栏协同" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,8"/>

                            <CheckBox x:Name="FullscreenHideCheck" Content="检测到全屏游戏或全屏视频时自动静默隐藏 Dock" Margin="0,4,0,8" Checked="OnSettingChanged" Unchecked="OnSettingChanged"/>
                            <CheckBox x:Name="HideTaskbarCheck" Content="自动隐藏 Windows 原生任务栏（安全机制：退出或异常终止均自动恢复）" Margin="0,4,0,6" Checked="OnSettingChanged" Unchecked="OnSettingChanged"/>
                            <TextBlock x:Name="TaskbarUncheckedHintText"
                                       Text="提示：未开启隐藏原生任务栏时，Dock 会自动悬浮在原生任务栏上方，互不遮挡。"
                                       FontSize="12"
                                       Opacity="0.68"
                                       TextWrapping="Wrap"
                                       Margin="24,0,0,4"/>
                            <TextBlock x:Name="TaskbarCheckedHintText"
                                       Text="已开启原生任务栏隐藏，退出 DeskGrid 或异常终止时将自动恢复；也可随时点击 Dock 齿轮菜单恢复。"
                                       FontSize="12"
                                       Opacity="0.78"
                                       TextWrapping="Wrap"
                                       Visibility="Collapsed"
                                       Margin="24,0,0,4"/>

                            <Separator Margin="0,10,0,14"/>
                            <TextBlock Text="Dock 右侧时钟" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,8"/>

                            <CheckBox x:Name="ShowDockClockCheck" Content="在 Dock 栏右侧显示极简时钟（点击可打开快捷电源菜单）" Margin="0,4,0,8" Checked="OnSettingChanged" Unchecked="OnSettingChanged"/>
                            <StackPanel x:Name="ClockOptionsPanel" Margin="24,0,0,4">
                                <CheckBox x:Name="Clock24HourCheck" Content="使用 24 小时制（关闭后切换为 12 小时制）" Margin="0,2,0,8" Checked="OnSettingChanged" Unchecked="OnSettingChanged"/>
                                <CheckBox x:Name="ClockShowSecondsCheck" Content="显示秒数" Margin="0,2,0,8" Checked="OnSettingChanged" Unchecked="OnSettingChanged"/>
                                <CheckBox x:Name="ClockShowDateCheck" Content="显示日期与星期" Margin="0,2,0,4" Checked="OnSettingChanged" Unchecked="OnSettingChanged"/>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>

                <!-- Section 3: 配置与备份 -->
                <ScrollViewer x:Name="BackupSection"
                              Visibility="Collapsed"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              CanContentScroll="False"
                              Padding="6,4,10,4">
                    <StackPanel>
                        <TextBlock Text="配置导入导出与恢复" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,6"/>
                        <TextBlock Text="所有桌面盒子布局、虚拟条目与 Dock 固定项均以 JSON 保存在本地，并自动维护 3 份滚动备份。"
                                   TextWrapping="Wrap"
                                   Opacity="0.75"
                                   Margin="0,0,0,16"/>

                        <WrapPanel Margin="0,0,0,16">
                            <Button Content="导出配置 (.deskgrid)" Height="34" Padding="14,0" Margin="0,0,10,8" Click="OnExportConfig"/>
                            <Button Content="导入配置..." Height="34" Padding="14,0" Margin="0,0,10,8" Click="OnImportConfig"/>
                            <Button Content="打开配置目录" Height="34" Padding="14,0" Margin="0,0,10,8" Click="OnOpenConfigFolder"/>
                        </WrapPanel>

                        <Separator Margin="0,6,0,16"/>
                        <TextBlock Text="紧急恢复与重置" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,8"/>
                        <WrapPanel>
                            <Button Content="立即恢复系统任务栏与原生图标" Height="34" Padding="14,0" Margin="0,0,10,8" Click="OnEmergencyRestore"/>
                            <Button Content="重置为默认布局" Height="34" Padding="14,0" Margin="0,0,10,8" Click="OnResetDefaults"/>
                        </WrapPanel>
                    </StackPanel>
                </ScrollViewer>

                <!-- Section 4: 关于与支持 -->
                <ScrollViewer x:Name="AboutSection"
                              Visibility="Collapsed"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              CanContentScroll="False"
                              Padding="6,4,10,4">
                    <StackPanel>
                        <TextBlock Text="DeskGrid 桌面整理助手" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <TextBlock Text="版本 v0.2.0 · 开源轻量 Windows 桌面分区收纳与 Fluent Dock 栏"
                                   Opacity="0.75"
                                   Margin="0,0,0,16"/>

                        <Separator Margin="0,0,0,14"/>
                        <TextBlock Text="安全守护与退出方式" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,8"/>
                        <TextBlock Text="• 开启「自动隐藏系统任务栏」后，内置独立看门狗进程守护主程序，即使在任务管理器中强杀也会自动恢复主副屏任务栏。"
                                   TextWrapping="Wrap"
                                   Opacity="0.82"
                                   Margin="0,0,0,6"/>
                        <TextBlock Text="• 任何时候均可通过左下角「安全退出」按钮、Dock 齿轮菜单、系统托盘菜单或桌面盒子右键菜单安全退出并完整恢复系统状态。"
                                   TextWrapping="Wrap"
                                   Opacity="0.82"
                                   Margin="0,0,0,16"/>

                        <Separator Margin="0,0,0,14"/>
                        <TextBlock Text="快捷操作提示" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,8"/>
                        <TextBlock Text="• 双击桌面空白处：一键隐藏 / 恢复所有桌面盒子" Opacity="0.82" Margin="0,0,0,4"/>
                        <TextBlock Text="• 点击 Dock 右侧时钟：弹出快捷电源控制面板（锁屏 / 睡眠 / 重启 / 关机）" Opacity="0.82" Margin="0,0,0,4"/>
                        <TextBlock Text="• 选中盒子内图标按 F2 / Del / Esc：重命名、移除/删除或取消选中" Opacity="0.82" Margin="0,0,0,4"/>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="完成" Width="88" Height="32" IsDefault="True" Click="OnClose"/>
        </StackPanel>
    </Grid>
</Window>
