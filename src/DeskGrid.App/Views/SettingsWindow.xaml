<Window x:Class="DeskGrid.App.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DeskGrid 偏好设置"
        Icon="pack://application:,,,/Assets/app.ico"
        Foreground="{DynamicResource DgSettingsTextPrimaryBrush}"
        Width="780"
        Height="620"
        MinWidth="680"
        MinHeight="500"
        ShowInTaskbar="True"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="ClearType"
        Closing="OnWindowClosing">
    <Window.Resources>
        <Style x:Key="DgSettingsNavRadioStyle" TargetType="RadioButton">
            <Setter Property="Height" Value="38"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
            <Setter Property="Padding" Value="12,0,12,0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource DgSettingsNavForegroundBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <Grid>
                                <Border x:Name="ActivePill"
                                        Width="3"
                                        Height="16"
                                        CornerRadius="1.5"
                                        HorizontalAlignment="Left"
                                        Margin="-8,0,0,0"
                                        Background="#0A84FF"
                                        Visibility="Collapsed"/>
                                <ContentPresenter x:Name="ContentSite"
                                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                                  TextElement.Foreground="{TemplateBinding Foreground}">
                                    <ContentPresenter.Resources>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="FontFamily" Value="{StaticResource DgUiFontFamily}"/>
                                            <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                                            <Setter Property="UseLayoutRounding" Value="True"/>
                                            <Setter Property="SnapsToDevicePixels" Value="True"/>
                                            <Setter Property="TextOptions.TextFormattingMode" Value="Ideal"/>
                                            <Setter Property="TextOptions.TextRenderingMode" Value="ClearType"/>
                                        </Style>
                                        <Style TargetType="Path">
                                            <Setter Property="Fill" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                                        </Style>
                                    </ContentPresenter.Resources>
                                </ContentPresenter>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource DgSettingsNavHoverBackgroundBrush}"/>
                                <Setter TargetName="ContentSite" Property="TextElement.Foreground" Value="{DynamicResource DgSettingsNavHoverForegroundBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource DgSettingsNavSelectedBackgroundBrush}"/>
                                <Setter TargetName="ActivePill" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="ContentSite" Property="TextElement.Foreground" Value="{DynamicResource DgSettingsNavSelectedForegroundBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource DgSettingsNavHoverForegroundBrush}"/>
                </Trigger>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource DgSettingsNavSelectedForegroundBrush}"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="DgSettingsSafeExitButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="12,0,12,0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#E5484D"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#38E5484D"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              TextElement.Foreground="{TemplateBinding Foreground}">
                                <ContentPresenter.Resources>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="FontFamily" Value="{StaticResource DgUiFontFamily}"/>
                                        <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                    </Style>
                                </ContentPresenter.Resources>
                            </ContentPresenter>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1CE5484D"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#70E5484D"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#2EE5484D"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock Text="DeskGrid 设置" FontSize="22" FontWeight="SemiBold"/>
            <TextBlock Text="自定义桌面盒子、Dock 栏与系统协同行为"
                       Foreground="{DynamicResource DgSettingsTextSecondaryBrush}"
                       Margin="0,2,0,0"/>
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="176"/>
                <ColumnDefinition Width="1"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left Navigation Rail -->
            <Grid Grid.Column="0" Margin="0,0,12,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0">
                    <StackPanel.Resources>
                        <Style TargetType="TextBlock">
                            <Setter Property="FontFamily" Value="{StaticResource DgUiFontFamily}"/>
                            <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                            <Setter Property="UseLayoutRounding" Value="True"/>
                            <Setter Property="SnapsToDevicePixels" Value="True"/>
                            <Setter Property="TextOptions.TextFormattingMode" Value="Ideal"/>
                            <Setter Property="TextOptions.TextRenderingMode" Value="ClearType"/>
                        </Style>
                        <Style TargetType="Path">
                            <Setter Property="Fill" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                        </Style>
                    </StackPanel.Resources>
                    <RadioButton x:Name="NavAppearanceRadio"
                                 GroupName="SettingsNav"
                                 Style="{StaticResource DgSettingsNavRadioStyle}"
                                 IsChecked="True"
                                 Checked="OnNavSectionChanged">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="&#xE790;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <TextBlock Text="外观与桌面" VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>

                    <RadioButton x:Name="NavDockRadio"
                                 GroupName="SettingsNav"
                                 Style="{StaticResource DgSettingsNavRadioStyle}"
                                 Checked="OnNavSectionChanged">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="&#xE756;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <TextBlock Text="Dock 栏" VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>

                    <RadioButton x:Name="NavBackupRadio"
                                 GroupName="SettingsNav"
                                 Style="{StaticResource DgSettingsNavRadioStyle}"
                                 Checked="OnNavSectionChanged">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="&#xE74E;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <TextBlock Text="配置与备份" VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>

                    <RadioButton x:Name="NavAboutRadio"
                                 GroupName="SettingsNav"
                                 Style="{StaticResource DgSettingsNavRadioStyle}"
                                 Checked="OnNavSectionChanged">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="&#xE946;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <TextBlock Text="关于与支持" VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>
                </StackPanel>

                <!-- Independent Safe Exit Button pinned at the very bottom of the left nav rail -->
                <StackPanel Grid.Row="1" Margin="0,8,0,0">
                    <Separator Margin="0,0,0,10" Opacity="0.5"/>
                    <Button x:Name="SafeExitButton"
                            Style="{StaticResource DgSettingsSafeExitButtonStyle}"
                            ToolTip="恢复原生任务栏与桌面图标并安全退出 DeskGrid"
                            Click="OnSafeExit">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="&#xE7E8;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <TextBlock Text="安全退出" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Subtle vertical divider -->
            <Border Grid.Column="1" Background="{DynamicResource DgSettingsDividerBrush}"/>

            <!-- Right Content Sections -->
            <Grid Grid.Column="2" Margin="14,0,0,0">
                <!-- Section 1: 外观与桌面 -->
                <ScrollViewer x:Name="AppearanceSection"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              PanningMode="VerticalOnly"
                              CanContentScroll="False"
                              Padding="6,4,10,4">
                    <StackPanel>
                        <TextBlock Text="视觉主题" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,8"/>
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="深浅色模式" VerticalAlignment="Center"/>
                            <ComboBox x:Name="ThemeCombo" Grid.Column="1" Width="220" HorizontalAlignment="Left" SelectionChanged="OnSettingChanged">
                                <ComboBoxItem Content="跟随 Windows 系统" Tag="System"/>
                                <ComboBoxItem Content="浅色模式" Tag="Light"/>
                                <ComboBoxItem Content="深色模式" Tag="Dark"/>
                            </ComboBox>
                        </Grid>

                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Win11 毛玻璃材质" VerticalAlignment="Center"/>
                            <ComboBox x:Name="BackdropCombo" Grid.Column="1" Width="220" HorizontalAlignment="Left" SelectionChanged="OnSettingChanged">
                                <ComboBoxItem Content="Acrylic 亚克力" Tag="Acrylic"/>
                                <ComboBoxItem Content="Mica 云母" Tag="Mica"/>
                            </ComboBox>
                        </Grid>

                        <Grid Margin="0,0,0,18">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="48"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="玻璃默认着色浓度" VerticalAlignment="Center"/>
                            <Slider x:Name="OpacitySlider"
                                    Grid.Column="1"
                                    Minimum="0.18"
                                    Maximum="0.80"
                                    SmallChange="0.01"
                                    LargeChange="0.05"
                                    TickFrequency="0.01"
                                    ScrollViewer.PanningMode="None"
                                    IsSnapToTickEnabled="False"
                                    IsMoveToPointEnabled="True"
                                    ValueChanged="OnOpacitySliderValueChanged"/>
                            <TextBlock x:Name="OpacityValueText" Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                        </Grid>

                        <Separator Margin="0,4,0,14"/>
                        <TextBlock Text="桌面交互" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,8"/>

                        <CheckBox x:Name="StartupCheck" Content="随 Windows 开机自动启动（用户级，无需管理员权限）" Margin="0,4,0,8" Checked="OnSettingChanged" Unchecked="OnSettingChanged"/>
                        <CheckBox x:Name="DoubleClickDesktopCheck" Content="双击桌面空白处一键隐藏 / 恢复所有桌面盒子" Margin="0,4,0,8" Checked="OnSettingChanged" Unchecked="OnSettingChanged"/>
                        <CheckBox x:Name="GridSnapCheck" Content="拖拽与缩放盒子时启用网格与边缘吸附对齐" Margin="0,4,0,8" Checked="OnSettingChanged" Unchecked="OnSettingChanged"/>
                    </StackPanel>
                </ScrollViewer>

                <!-- Section 2: Dock 栏 -->
                <ScrollViewer x:Name="DockSection"
                              Visibility="Collapsed"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              PanningMode="VerticalOnly"
                              CanContentScroll="False"
                              Padding="6,4,10,4">
                    <StackPanel>
                        <TextBlock Text="Dock 体验与动效" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,8"/>
                        <CheckBox x:Name="ShowDockCheck" Content="启用底部悬浮 Dock 栏" Margin="0,4,0,10" Checked="OnSettingChanged" Unchecked="OnSettingChanged"/>

                        <StackPanel x:Name="DockOptionsPanel">
                            <CheckBox x:Name="MagnificationCheck" Content="启用鼠标悬停波浪放大动效" Margin="0,0,0,10" Checked="OnSettingChanged" Unchecked="OnSettingChanged"/>

                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="160"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="48"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="最大放大倍率" VerticalAlignment="Center"/>
                                <Slider x:Name="MagScaleSlider"
                                        Grid.Column="1"
                                        Minimum="1.10"
                                        Maximum="1.70"
                                        SmallChange="0.01"
                                        LargeChange="0.05"
                                        TickFrequency="0.01"
                                        ScrollViewer.PanningMode="None"
                                        IsSnapToTickEnabled="False"
                                        IsMoveToPointEnabled="True"
                                        ValueChanged="OnMagScaleSliderValueChanged"/>
                                <TextBlock x:Name="MagScaleValueText" Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                            </Grid>

                            <Separator Margin="0,4,0,14"/>
                            <TextBlock Text="防打扰与任务栏协同" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,8"/>

                            <CheckBox x:Name="FullscreenHideCheck" Content="检测到全屏游戏或全屏视频时自动静默隐藏 Dock" Margin="0,4,0,8" Checked="OnSettingChanged" Unchecked="OnSettingChanged"/>
                            <CheckBox x:Name="HideTaskbarCheck" Content="自动隐藏 Windows 原生任务栏（安全退出或重启后自动恢复）" Margin="0,4,0,6" Checked="OnSettingChanged" Unchecked="OnSettingChanged"/>
                            <TextBlock x:Name="TaskbarUncheckedHintText"
                                       Text="提示：未开启隐藏原生任务栏时，Dock 会自动悬浮在原生任务栏上方，互不遮挡。"
                                       FontSize="12"
                                       Foreground="{DynamicResource DgSettingsTextSecondaryBrush}"
                                       TextWrapping="Wrap"
                                       Margin="24,0,0,4"/>
                            <TextBlock x:Name="TaskbarCheckedHintText"
                                       Text="已开启原生任务栏隐藏，通过系统托盘或左下角「安全退出」关闭时将自动恢复；也可随时点击 Dock 齿轮菜单恢复。"
                                       FontSize="12"
                                       Foreground="{DynamicResource DgSettingsTextSecondaryBrush}"
                                       TextWrapping="Wrap"
                                       Visibility="Collapsed"
                                       Margin="24,0,0,4"/>

                            <Separator Margin="0,10,0,14"/>
                            <TextBlock Text="Dock 右侧时钟" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,8"/>

                            <CheckBox x:Name="ShowDockClockCheck" Content="在 Dock 栏右侧显示极简时钟（点击可打开快捷电源菜单）" Margin="0,4,0,8" Checked="OnSettingChanged" Unchecked="OnSettingChanged"/>
                            <StackPanel x:Name="ClockOptionsPanel" Margin="24,0,0,4">
                                <CheckBox x:Name="Clock24HourCheck" Content="使用 24 小时制（关闭后切换为 12 小时制）" Margin="0,2,0,8" Checked="OnSettingChanged" Unchecked="OnSettingChanged"/>
                                <CheckBox x:Name="ClockShowSecondsCheck" Content="显示秒数" Margin="0,2,0,8" Checked="OnSettingChanged" Unchecked="OnSettingChanged"/>
                                <CheckBox x:Name="ClockShowDateCheck" Content="显示日期与星期" Margin="0,2,0,4" Checked="OnSettingChanged" Unchecked="OnSettingChanged"/>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>

                <!-- Section 3: 配置与备份 -->
                <ScrollViewer x:Name="BackupSection"
                              Visibility="Collapsed"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              PanningMode="VerticalOnly"
                              CanContentScroll="False"
                              Padding="6,4,10,4">
                    <StackPanel>
                        <TextBlock Text="配置导入导出与恢复" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,6"/>
                        <TextBlock Text="所有桌面盒子布局、虚拟条目与 Dock 固定项均以 JSON 保存在本地，并自动维护 3 份滚动备份。"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource DgSettingsTextSecondaryBrush}"
                                   Margin="0,0,0,16"/>

                        <WrapPanel Margin="0,0,0,16">
                            <Button Content="导出配置 (.deskgrid)" Height="34" Padding="14,0" Margin="0,0,10,8" Click="OnExportConfig"/>
                            <Button Content="导入配置..." Height="34" Padding="14,0" Margin="0,0,10,8" Click="OnImportConfig"/>
                            <Button Content="打开配置目录" Height="34" Padding="14,0" Margin="0,0,10,8" Click="OnOpenConfigFolder"/>
                        </WrapPanel>

                        <Separator Margin="0,6,0,16"/>
                        <TextBlock Text="紧急恢复与重置" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,8"/>
                        <WrapPanel>
                            <Button Content="立即恢复系统任务栏与原生图标" Height="34" Padding="14,0" Margin="0,0,10,8" Click="OnEmergencyRestore"/>
                            <Button Content="重置为默认布局" Height="34" Padding="14,0" Margin="0,0,10,8" Click="OnResetDefaults"/>
                        </WrapPanel>
                    </StackPanel>
                </ScrollViewer>

                <!-- Section 4: 关于与支持 -->
                <ScrollViewer x:Name="AboutSection"
                              Visibility="Collapsed"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              PanningMode="VerticalOnly"
                              CanContentScroll="False"
                              Padding="6,4,10,8">
                    <StackPanel>
                        <!-- Card 1: 软件信息与版权声明 -->
                        <Border Background="{DynamicResource DgSettingsCardBackgroundBrush}"
                                BorderBrush="{DynamicResource DgSettingsCardBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="12"
                                Padding="18,16"
                                Margin="0,0,0,14">
                            <StackPanel>
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <Border Width="56"
                                            Height="56"
                                            CornerRadius="12"
                                            Margin="0,0,14,0"
                                            VerticalAlignment="Center"
                                            ClipToBounds="True">
                                        <Image x:Name="AboutAppIcon"
                                               Width="56"
                                               Height="56"
                                               Stretch="UniformToFill"
                                               RenderOptions.BitmapScalingMode="HighQuality"/>
                                    </Border>

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="DeskGrid（桌格）"
                                                       FontSize="17"
                                                       FontWeight="SemiBold"
                                                       VerticalAlignment="Center"/>
                                            <Border Background="{DynamicResource DgSettingsBadgeBackgroundBrush}"
                                                    CornerRadius="6"
                                                    Padding="8,2"
                                                    Margin="10,0,0,0"
                                                    VerticalAlignment="Center">
                                                <TextBlock Text="v0.2.0"
                                                           FontSize="11.5"
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource DgSettingsBadgeForegroundBrush}"/>
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Text="轻量级 Windows 液态毛玻璃桌面整理与悬浮 Dock 工具"
                                                   FontSize="13"
                                                   Foreground="{DynamicResource DgSettingsTextSecondaryBrush}"
                                                   TextWrapping="Wrap"
                                                   Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Grid>

                                <Border Height="1" Background="{DynamicResource DgSettingsDividerBrush}" Margin="0,2,0,12"/>

                                <TextBlock Text="Copyright © 2026 Jens (JINGSEN11). All Rights Reserved."
                                           FontSize="12.5"
                                           FontWeight="SemiBold"
                                           Margin="0,0,0,6"/>
                                <TextBlock FontSize="12.5"
                                           Foreground="{DynamicResource DgSettingsTextSecondaryBrush}"
                                           TextWrapping="Wrap"
                                           LineHeight="20"
                                           Margin="0,0,0,4">
                                    <Run Text="本软件基于 "/>
                                    <Run Text="MIT License" FontWeight="SemiBold" Foreground="{DynamicResource DgSettingsTextPrimaryBrush}"/>
                                    <Run Text=" 开源发布，纯免费、无广告、无后台联网收集。"/>
                                </TextBlock>
                                <TextBlock Text="严禁任何第三方将本软件二次打包进行商业售卖或捆绑推广；二次分发请保留原作者署名与开源仓库地址。"
                                           FontSize="12.5"
                                           Foreground="{DynamicResource DgSettingsTextSecondaryBrush}"
                                           TextWrapping="Wrap"
                                           LineHeight="20"
                                           Margin="0,0,0,14"/>

                                <Button Content="访问 GitHub 开源主页"
                                        HorizontalAlignment="Left"
                                        Height="34"
                                        Padding="16,0"
                                        Cursor="Hand"
                                        Click="OnOpenGitHub"/>
                            </StackPanel>
                        </Border>

                        <!-- Card 2: 支持与关注（微信赞赏 & 小红书双二维码通道） -->
                        <Border x:Name="SupportQrCard"
                                Background="{DynamicResource DgSettingsCardBackgroundBrush}"
                                BorderBrush="{DynamicResource DgSettingsCardBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="12"
                                Padding="18,16">
                            <StackPanel>
                                <TextBlock Text="支持与关注"
                                           FontSize="15"
                                           FontWeight="SemiBold"
                                           Margin="0,0,0,6"/>
                                <TextBlock Text="DeskGrid 由独立开发者利用课余时间维护。如果这个小工具让你的桌面变得更顺眼、更顺手，欢迎请我喝杯咖啡，或扫码关注小红书追更后续版本与反馈建议！"
                                           FontSize="12.5"
                                           Foreground="{DynamicResource DgSettingsTextSecondaryBrush}"
                                           TextWrapping="Wrap"
                                           LineHeight="20"
                                           Margin="0,0,0,16"/>

                                <StackPanel x:Name="QrCardsContainer"
                                            Orientation="Horizontal"
                                            HorizontalAlignment="Center">
                                    <!-- 左侧：微信赞赏 -->
                                    <StackPanel x:Name="WechatQrCard" HorizontalAlignment="Center" Width="184">
                                        <Border Background="#FFFFFF"
                                                CornerRadius="12"
