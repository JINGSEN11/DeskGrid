<Window x:Class="DeskGrid.App.Views.WindowListPopup"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        SizeToContent="WidthAndHeight"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="Grayscale"
        PreviewKeyDown="OnPopupPreviewKeyDown"
        Deactivated="OnPopupDeactivated">
    <Window.Resources>
        <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="TextOptions.TextRenderingMode" Value="Grayscale"/>
        </Style>

        <!-- High-contrast light close button tailored for the dark frosted popup card -->
        <Style x:Key="PopupCloseButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="24"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#F3F4F6"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="UseLayoutRounding" Value="True"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}"
                                              TextElement.FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#2EFFFFFF"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.72"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid Margin="12">
        <!-- Dedicated sibling shadow + dark frosted surface (#E61E222A): never wraps foreground text -->
        <Border Background="#E61E222A"
                CornerRadius="12"
                IsHitTestVisible="False">
            <Border.Effect>
                <DropShadowEffect BlurRadius="22" ShadowDepth="6" Direction="270" Opacity="0.42" Color="#000000"/>
            </Border.Effect>
        </Border>
        <Border x:Name="PopupCardBorder"
                Background="Transparent"
                BorderBrush="#29FFFFFF"
                BorderThickness="1"
                CornerRadius="12"
                Padding="8"
                MinWidth="248"
                MaxWidth="368"
                SnapsToDevicePixels="True">
            <StackPanel>
                <TextBlock x:Name="AppHeaderText"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Foreground="#B8F3F4F6"
                           Margin="8,2,8,6"/>
                <StackPanel x:Name="WindowsListPanel"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
